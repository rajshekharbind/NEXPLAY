# NEXPLAY Root Environment Variables Example
# Duplicate this file to .env and adjust credentials as appropriate

PROJECT_NAME="NEXPLAY"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="nexplay_super_secret_development_key_change_in_production_32chars"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Database Configuration (PostgreSQL with fallback to SQLite for local lightweight testing)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexplay_db
# For Docker / production:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nexplay_db"
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/nexplay_db"
# Local development fallback:
SQLITE_DB_URL="sqlite+aiosqlite:///./nexplay_dev.db"
SYNC_SQLITE_DB_URL="sqlite:///./nexplay_dev.db"

# Redis Cache & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# CORS Origins (JSON list or comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Frontend Public Variables
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_NAME="NEXPLAY"
NEXT_PUBLIC_APP_TAGLINE="One account. Every entertainment destination."

# External Services (Placeholders for upcoming phases)
TMDB_API_KEY=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
YOUTUBE_API_KEY=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
